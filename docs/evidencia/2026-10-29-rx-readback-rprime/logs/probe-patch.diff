 }

+
+/* ===== R' #369 — INSTRUMENTACION TEMPORAL READ-ONLY (NO INTEGRAR A MAIN) =====
+ * Un unico intento, OFF por defecto: solo corre si existe el flag temporal
+ * /tmp/x6200_reg12_probe.enable (no persistente; no se toca rootfs ni el daemon).
+ * Se ejecuta al final de radio_init(), con control_mux inicializado y
+ * radio_control_ok=true, ANTES de crear radio_thread: no hay writers concurrentes.
+ * Solo lecturas 0x2000/1B, 0x0038/4B y 0x0030/4B con el framing del vendor;
+ * no escribe valores. El flag y el log viven en /tmp.
+ */
+static int rxprobe_i2c_read(void *ctx, uint16_t addr, uint8_t *buf, size_t len) {
+    int fd = *(int *) ctx;
+    uint16_t sel = (uint16_t) (((addr & 0xFFu) << 8) | (addr >> 8));
+    struct i2c_msg msgs[2] = {
+        { .addr = 0x72, .flags = 0, .len = 2, .buf = (uint8_t *) &sel },
+        { .addr = 0x72, .flags = I2C_M_RD, .len = (uint16_t) len, .buf = buf },
+    };
+    struct i2c_rdwr_ioctl_data p = { .msgs = msgs, .nmsgs = 2 };
+    if (ioctl(fd, I2C_RDWR, &p) < 0) {
+        return -errno;
+    }
+    return 0;
+}
+static uint64_t rxprobe_now(void *ctx) { (void) ctx; return get_time(); }
+static bool rxprobe_radio_rx(void *ctx) {
+    (void) ctx;
+    return radio_control_ok && state == RADIO_RX;   /* gate antes de cada transaccion */
+}
+static bool rxprobe_writer(void *ctx) { (void) ctx; return false; } /* sin radio_thread aun */
+static void rxprobe_lock(void *ctx) { (void) ctx; radio_lock(); }
+static void rxprobe_unlock(void *ctx) { (void) ctx; radio_unlock(); }
+static void rxprobe_pause(void *ctx, uint32_t ms) { (void) ctx; usleep(ms * 1000u); }
+
+static void rxprobe_maybe_run(void) {
+    if (!rxprobe_enabled()) {
+        return;   /* OFF por defecto: no abre fd ni hace ioctl ni escribe log */
+    }
+    int fd = open("/dev/i2c-0", O_RDWR);
+    if (fd < 0) {
+        LV_LOG_WARN("READBACK_PROBE_DONE verdict=BLOCKED_BUS open /dev/i2c-0: %s",
+                    strerror(errno));
+        return;
+    }
+    rxprobe_ops_t ops = {
+        .i2c_read = rxprobe_i2c_read,
+        .now_ms = rxprobe_now,
+        .radio_is_rx = rxprobe_radio_rx,
+        .concurrent_writer = rxprobe_writer,
+        .lock = rxprobe_lock,
+        .unlock = rxprobe_unlock,
+        .pause_ms = rxprobe_pause,
+        .ctx = &fd,
+    };
+    rxprobe_result_t out;
+    rxprobe_verdict_t v = rxprobe_run_once(&ops, &out);
+    /* Sombra SOLO diagnostica, nunca readback. */
+    out.reg12_shadow = x6200_control_get(x6200_sple_atue_trx);
+    out.rxvol_shadow = x6200_control_get(x6200_rxvol);
+    rxprobe_log(RXPROBE_LOG_PATH, &out);
+    LV_LOG_USER("READBACK_PROBE_DONE verdict=%s reads=%d",
+                rxprobe_verdict_name(v), out.reads);
+    close(fd);
+}
+
 void radio_init(radio_state_change_t tx_cb, radio_state_change_t rx_cb) {
     /* La politica visual arranca en QUALITY: el modo Ahorro del waterfall solo
      * cambia si el pack lo pide (UI-08 incr. 2). Despues se aplica el override
@@ -822,6 +887,9 @@ void radio_init(radio_state_change_t tx_cb, radio_state_change_t rx_cb) {
      * activo una vez, ya con el mutex del control creado. */
     radio_sync_active_vfo_mode();

+    /* R' #369: un unico intento read-only, OFF salvo flag /tmp/x6200_reg12_probe.enable. */
+    rxprobe_maybe_run();
+
     pthread_t thread;

     pthread_create(&thread, NULL, radio_thread, NULL);
diff --git a/src/rx_reg12_probe.c b/src/rx_reg12_probe.c
new file mode 100644
index 000000000..bfb592d25
--- /dev/null
+++ b/src/rx_reg12_probe.c
@@ -0,0 +1,231 @@
+/*
+ *  SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ *  Xiegu X6200 LVGL GUI
+ *
+ *  PARCHE TEMPORAL DE DIAGNOSTICO — Fase R' (#369). NO INTEGRAR A PRODUCCION.
+ *  Ver rx_reg12_probe.h. Logica pura/testeable: el unico acceso al bus es a
+ *  traves de ops->i2c_read (no existe ops->write de valores).
+ */
+
+#define _POSIX_C_SOURCE 200809L
+
+#include "rx_reg12_probe.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <string.h>
+
+static bool probe_done = false;
+
+void rxprobe_test_reset(void) {
+    probe_done = false;
+}
+
+bool rxprobe_enabled(void) {
+    /* ON sólo con el flag temporal en /tmp (no persistente, no rootfs/daemon). */
+    return access(RXPROBE_FLAG_PATH, R_OK) == 0;
+}
+
+const char *rxprobe_verdict_name(rxprobe_verdict_t v) {
+    switch (v) {
+        case RXPROBE_OFF: return "OFF";
+        case RXPROBE_CANDIDATE: return "R_CANDIDATE_FOUND";
+        case RXPROBE_NO_READBACK: return "R_NO_READBACK_ON_TESTED_PROTOCOL";
+        case RXPROBE_INCONCLUSIVE: return "R_INCONCLUSIVE";
+        case RXPROBE_UNSAFE: return "BLOCKED_UNSAFE";
+        case RXPROBE_ALREADY_DONE: return "ALREADY_DONE";
+        default: return "UNKNOWN";
+    }
+}
+
+static uint32_t le32(const uint8_t *p) {
+    return (uint32_t) p[0] | ((uint32_t) p[1] << 8) | ((uint32_t) p[2] << 16) |
+           ((uint32_t) p[3] << 24);
+}
+
+static bool all_same_byte(const uint8_t *b, size_t n, uint8_t v) {
+    for (size_t i = 0; i < n; i++) {
+        if (b[i] != v) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* Lee una direccion con el framing del vendor: selector 2 B BE + read N.
+ * Nunca reintenta; devuelve 0 o -errno. */
+static int read_reg(const rxprobe_ops_t *ops, uint16_t addr, uint8_t *buf, size_t len) {
+    return ops->i2c_read(ops->ctx, addr, buf, len);
+}
+
+static void snapshot_radio(rxprobe_result_t *r, const rxprobe_ops_t *ops) {
+    if (ops->radio_is_rx != NULL && !ops->radio_is_rx(ops->ctx)) {
+        r->verdict = RXPROBE_UNSAFE;
+        snprintf(r->reason, sizeof(r->reason), "radio no en RX/tx=false antes de leer");
+    }
+    if (ops->concurrent_writer != NULL && ops->concurrent_writer(ops->ctx)) {
+        r->verdict = RXPROBE_UNSAFE;
+        snprintf(r->reason, sizeof(r->reason), "writer concurrente detectado; no se lee");
+    }
+}
+
+rxprobe_verdict_t rxprobe_run_once(const rxprobe_ops_t *ops, rxprobe_result_t *out) {
+    rxprobe_result_t local;
+    rxprobe_result_t *r = out != NULL ? out : &local;
+
+    memset(r, 0, sizeof(*r));
+    r->verdict = RXPROBE_INCONCLUSIVE;
+
+    if (probe_done) {
+        r->verdict = RXPROBE_ALREADY_DONE;
+        snprintf(r->reason, sizeof(r->reason), "unico intento ya consumido");
+        return r->verdict;
+    }
+    if (ops == NULL || ops->i2c_read == NULL || ops->now_ms == NULL) {
+        r->verdict = RXPROBE_UNSAFE;
+        snprintf(r->reason, sizeof(r->reason), "sin backend de lectura/reloj");
+        return r->verdict;
+    }
+
+    /* Gate global: radio en RX y sin writers concurrentes, antes de tocar el bus. */
+    snapshot_radio(r, ops);
+    if (r->verdict == RXPROBE_UNSAFE) {
+        return r->verdict;
+    }
+
+    probe_done = true;
+
+    /* (a) Control conocido del vendor: 0x2000 / 1 B. Si falla, no se sigue. */
+    uint8_t ctl = 0;
+    r->control_ms = ops->now_ms(ops->ctx);
+    r->control_rc = read_reg(ops, RXPROBE_REG_CONTROL, &ctl, 1);
+    r->control_byte = ctl;
+    r->reads++;
+    if (r->control_rc != 0 || ctl == 0) {
+        r->verdict = (r->control_rc != 0) ? RXPROBE_NO_READBACK : RXPROBE_INCONCLUSIVE;
+        snprintf(r->reason, sizeof(r->reason),
+                 "control 0x2000 fallo (rc=%d byte=%02x): no se sigue",
+                 r->control_rc, ctl);
+        return r->verdict;
+    }
+
+    /* (b) 0x0038 / 4 B y (c) 0x0030 / 4 B: una lectura cada uno, bajo un mismo
+     * lock atomico. El llamador provee lock/unlock (radio_lock de la GUI). */
+    if (ops->lock != NULL) {
+        ops->lock(ops->ctx);
+    }
+    r->rxvol_ms[0] = ops->now_ms(ops->ctx);
+    r->rxvol_rc[0] = read_reg(ops, RXPROBE_REG_RXVOL, r->rxvol_raw[0], 4);
+    r->rxvol_le[0] = le32(r->rxvol_raw[0]);
+    r->reads++;
+    r->reg12_ms[0] = ops->now_ms(ops->ctx);
+    r->reg12_rc[0] = read_reg(ops, RXPROBE_REG_SPLE_TRX, r->reg12_raw[0], 4);
+    r->reg12_le[0] = le32(r->reg12_raw[0]);
+    r->reads++;
+
+    if (ops->unlock != NULL) {
+        ops->unlock(ops->ctx);
+    }
+    if (r->rxvol_rc[0] != 0 || r->reg12_rc[0] != 0) {
+        r->verdict = RXPROBE_NO_READBACK;
+        snprintf(r->reason, sizeof(r->reason),
+                 "lecturas b/c fallaron (rxvol_rc=%d reg12_rc=%d)",
+                 r->rxvol_rc[0], r->reg12_rc[0]);
+        return r->verdict;
+    }
+
+    /* Segunda lectura UNICA tras 50 ms, SIN retener el lock. Solo si la primera
+     * fue valida. Rechequea el gate de RX antes de la segunda transaccion. */
+    if (ops->pause_ms != NULL) {
+        ops->pause_ms(ops->ctx, RXPROBE_SECOND_DELAY_MS);
+    }
+    snapshot_radio(r, ops);
+    if (r->verdict == RXPROBE_UNSAFE) {
+        snprintf(r->reason, sizeof(r->reason),
+                 "radio dejo de estar en RX/writer concurrente antes de la 2a lectura");
+        return r->verdict;
+    }
+    if (ops->lock != NULL) {
+        ops->lock(ops->ctx);
+    }
+    r->rxvol_ms[1] = ops->now_ms(ops->ctx);
+    r->rxvol_rc[1] = read_reg(ops, RXPROBE_REG_RXVOL, r->rxvol_raw[1], 4);
+    r->rxvol_le[1] = le32(r->rxvol_raw[1]);
+    r->reads++;
+    r->reg12_ms[1] = ops->now_ms(ops->ctx);
+    r->reg12_rc[1] = read_reg(ops, RXPROBE_REG_SPLE_TRX, r->reg12_raw[1], 4);
+    r->reg12_le[1] = le32(r->reg12_raw[1]);
+    r->reads++;
+
+    if (ops->unlock != NULL) {
+        ops->unlock(ops->ctx);
+    }
+    if (r->rxvol_rc[1] != 0 || r->reg12_rc[1] != 0) {
+        r->verdict = RXPROBE_NO_READBACK;
+        snprintf(r->reason, sizeof(r->reason),
+                 "segunda lectura fallo (rxvol_rc=%d reg12_rc=%d)",
+                 r->rxvol_rc[1], r->reg12_rc[1]);
+        return r->verdict;
+    }
+
+    bool stable = memcmp(r->rxvol_raw[0], r->rxvol_raw[1], 4) == 0 &&
+                  memcmp(r->reg12_raw[0], r->reg12_raw[1], 4) == 0;
+    bool trivial_rxvol = all_same_byte(r->rxvol_raw[0], 4, 0x00) ||
+                         all_same_byte(r->rxvol_raw[0], 4, 0xFF);
+    bool trivial_reg12 = all_same_byte(r->reg12_raw[0], 4, 0x00) ||
+                         all_same_byte(r->reg12_raw[0], 4, 0xFF);
+
+    if (!stable) {
+        r->verdict = RXPROBE_INCONCLUSIVE;
+        snprintf(r->reason, sizeof(r->reason),
+                 "b/c cambian entre las dos lecturas (no estable)");
+        return r->verdict;
+    }
+    if (trivial_rxvol && trivial_reg12) {
+        /* uniformidad NO prueba error ni exito: INCONCLUSIVE, no PASS */
+        r->verdict = RXPROBE_INCONCLUSIVE;
+        snprintf(r->reason, sizeof(r->reason),
+                 "ambas lecturas uniformes/triviales (00/FF); no atribuible");
+        return r->verdict;
+    }
+
+    r->verdict = RXPROBE_CANDIDATE;
+    snprintf(r->reason, sizeof(r->reason),
+             "bytes estables no triviales; SOLO hipotesis de readback, sin verdad fisica");
+    return r->verdict;
+}
+
+void rxprobe_log(const char *path, const rxprobe_result_t *r) {
+    if (path == NULL || r == NULL) {
+        return;
+    }
+    FILE *f = fopen(path, "a");
+    if (f == NULL) {
+        return;
+    }
+    fprintf(f, "READBACK_PROBE_DONE verdict=%s reads=%d reason=\"%s\"\n",
+            rxprobe_verdict_name(r->verdict), r->reads, r->reason);
+    fprintf(f, "control 0x2000/1 rc=%d byte=%02X t=%llu ms\n",
+            r->control_rc, r->control_byte,
+            (unsigned long long) r->control_ms);
+    for (int i = 0; i < 2; i++) {
+        fprintf(f,
+                "rxvol 0x0038/4 #%d rc=%d raw=%02X %02X %02X %02X le=%u t=%llu ms\n",
+                i + 1, r->rxvol_rc[i], r->rxvol_raw[i][0], r->rxvol_raw[i][1],
+                r->rxvol_raw[i][2], r->rxvol_raw[i][3], r->rxvol_le[i],
+                (unsigned long long) r->rxvol_ms[i]);
+    }
+    for (int i = 0; i < 2; i++) {
+        fprintf(f,
+                "reg12 0x0030/4 #%d rc=%d raw=%02X %02X %02X %02X le=%u t=%llu ms\n",
+                i + 1, r->reg12_rc[i], r->reg12_raw[i][0], r->reg12_raw[i][1],
+                r->reg12_raw[i][2], r->reg12_raw[i][3], r->reg12_le[i],
+                (unsigned long long) r->reg12_ms[i]);
+    }
+    fprintf(f, "shadow reg12=0x%08X rxvol=0x%08X (solo diagnostico, NO readback)\n",
+            r->reg12_shadow, r->rxvol_shadow);
+    fclose(f);
+}
diff --git a/src/rx_reg12_probe.h b/src/rx_reg12_probe.h
new file mode 100644
index 000000000..054593b2e
--- /dev/null
+++ b/src/rx_reg12_probe.h
@@ -0,0 +1,86 @@
+/*
+ *  SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ *  Xiegu X6200 LVGL GUI
+ *
+ *  PARCHE TEMPORAL DE DIAGNOSTICO — Fase R' (#369). NO INTEGRAR A PRODUCCION.
+ *
+ *  Un unico intento de lectura read-only del registro 12 (0x0030) usando el
+ *  framing del GUI de fabrica (I2C-0, slave 0x72, selector 2 B BE + read N).
+ *  OFF por defecto: sólo hace algo si existe el flag temporal NO PERSISTENTE
+ *  /tmp/x6200_reg12_probe.enable (no se toca rootfs ni x6200_daemon). Sin flag
+ *  no abre el bus ni hace ningún ioctl.
+ *
+ *  Limites duros del issue: solo 0x2000/1B (control), 0x0038/4B y 0x0030/4B;
+ *  una unica segunda lectura de 0x0038/0x0030 tras 50 ms; sin reintentos; sin
+ *  barrido; sin escribir valores de registro (el selector de 2 B es parte del
+ *  framing de lectura del vendor, no un payload de 6 B).  Se ejecuta una sola vez.
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define RXPROBE_REG_CONTROL   0x2000u   /* readiness del baseband, 1 B */
+#define RXPROBE_REG_RXVOL     0x0038u   /* reg 14 (rxvol), 4 B        */
+#define RXPROBE_REG_SPLE_TRX  0x0030u   /* reg 12, 4 B                */
+#define RXPROBE_SECOND_DELAY_MS 50u
+#define RXPROBE_MAX_READS     5         /* control + 2 + 2            */
+
+typedef enum {
+    RXPROBE_OFF = 0,              /* flag de entorno ausente/!=1: no hace nada */
+    RXPROBE_CANDIDATE,            /* b/c responden con bytes estables no triviales */
+    RXPROBE_NO_READBACK,          /* control o lecturas fallan / incongruentes */
+    RXPROBE_INCONCLUSIVE,         /* responden pero triviales o sin control fisico */
+    RXPROBE_UNSAFE,               /* radio no en RX comprobable / writer concurrente */
+    RXPROBE_ALREADY_DONE,         /* segunda ejecucion: no se repite */
+} rxprobe_verdict_t;
+
+typedef struct {
+    /* backend: SOLO lectura. No hay callback de escritura de valores. */
+    int      (*i2c_read)(void *ctx, uint16_t addr, uint8_t *buf, size_t len);
+    uint64_t (*now_ms)(void *ctx);
+    bool     (*radio_is_rx)(void *ctx);          /* state==RADIO_RX y tx=false */
+    bool     (*concurrent_writer)(void *ctx);    /* true => abortar */
+    void     (*lock)(void *ctx);                 /* radio_lock de la GUI */
+    void     (*unlock)(void *ctx);               /* radio_unlock de la GUI */
+    void     (*pause_ms)(void *ctx, uint32_t ms);/* espera SIN retener el lock */
+    void     *ctx;
+} rxprobe_ops_t;
+
+typedef struct {
+    rxprobe_verdict_t verdict;
+    int      reads;                 /* ioctl de lectura ejecutados (<=5) */
+    int      control_rc;            /* 0 ok; -errno */
+    uint8_t  control_byte;
+    uint64_t control_ms;
+    int      rxvol_rc[2];
+    uint8_t  rxvol_raw[2][4];
+    uint32_t rxvol_le[2];
+    uint64_t rxvol_ms[2];
+    int      reg12_rc[2];
+    uint8_t  reg12_raw[2][4];
+    uint32_t reg12_le[2];
+    uint64_t reg12_ms[2];
+    uint32_t reg12_shadow;          /* solo diagnostico, no readback */
+    uint32_t rxvol_shadow;          /* solo diagnostico */
+    char     reason[160];
+} rxprobe_result_t;
+
+/* Solo tests del parche: repone el "unico intento" (no existe en produccion). */
+void rxprobe_test_reset(void);
+
+/* Flag de ejecución temporal: true si existe /tmp/x6200_reg12_probe.enable. */
+#define RXPROBE_FLAG_PATH "/tmp/x6200_reg12_probe.enable"
+#define RXPROBE_LOG_PATH  "/tmp/x6200_reg12_probe.log"
+bool rxprobe_enabled(void);
+
+/* Ejecuta el unico intento. Idempotente: la segunda llamada devuelve ALREADY_DONE
+ * sin tocar el bus. No escribe ningun registro. */
+rxprobe_verdict_t rxprobe_run_once(const rxprobe_ops_t *ops, rxprobe_result_t *out);
+
+/* Log legible (una linea por evento); no versionar salidas. */
+void rxprobe_log(const char *path, const rxprobe_result_t *r);
+const char *rxprobe_verdict_name(rxprobe_verdict_t v);
