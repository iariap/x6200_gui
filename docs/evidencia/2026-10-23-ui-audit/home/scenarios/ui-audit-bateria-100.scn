# ui-audit-bateria-100: estado de bateria 100 % para la auditoria de UI (#270).
# Ver el encabezado de `ui-audit-bateria-0.scn`: mismo estado de radio que
# `home-usb-20m`, solo cambia la muestra del pack.
#
# battery_cap 100 = BATTERY_FULL (src/clock.c) y el porcentaje mas ancho del
# panel, "100%", que es el caso que fija el borde derecho de la linea de estado.

name ui-audit-bateria-100
screen main

seed 20

frequency_hz 14074000
tx_frequency_hz 14074000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.6
external_v 13.8
battery_cap 100
charging false

rxtx rx
