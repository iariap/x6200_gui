# ui-audit-bateria-36: estado de bateria 36 % para la auditoria de UI (#270).
# Ver el encabezado de `ui-audit-bateria-0.scn`: mismo estado de radio que
# `home-usb-20m`, solo cambia la muestra del pack que `screens.c` le pasa a
# `clock_update_power()`. Este estado existe para el analisis de colision
# icono/porcentaje: LV_SYMBOL_BATTERY_2 (36..60).
#
# battery_cap 36 -> nivel 36 del icono (src/clock.c) y el texto "36%".

name ui-audit-bateria-36
screen main

seed 20

frequency_hz 14074000
tx_frequency_hz 14074000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.0
external_v 13.8
battery_cap 36
charging false

rxtx rx
