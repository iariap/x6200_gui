# ui-audit-bateria-50: estado de bateria 50 % para la auditoria de UI (#270).
# Ver el encabezado de `ui-audit-bateria-0.scn`: mismo estado de radio que
# `home-usb-20m`, solo cambia la muestra del pack.
#
# battery_cap 50 = nivel 2 del icono (BAT_LEVEL2_MAX 60, src/clock.c) y el
# porcentaje "50%".

name ui-audit-bateria-50
screen main

seed 20

frequency_hz 14074000
tx_frequency_hz 14074000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.0
external_v 13.8
battery_cap 50
charging false

rxtx rx
