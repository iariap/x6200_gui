+    if (cmd < sizeof(all_cmd.arg)/sizeof(all_cmd.arg[0])) all_cmd.arg[cmd] = arg;
+}
+
+bool x6200_control_bulk_write(const uint8_t *block, size_t len)
+{
+    if (block == NULL || len != 218) return false;
+    return send_regs(block, len);
+}
