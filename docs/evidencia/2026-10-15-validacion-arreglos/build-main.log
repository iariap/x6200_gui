for la in $(find /workspace/build/host/arm-buildroot-linux-gnueabihf/sysroot/usr/lib* -name "*.la"); do \
	cp -a "${la}" "${la}.fixed" && \
	/usr/bin/sed -i -e "s:/workspace/build:@BASE_DIR@:g" \
		-e "s:/workspace/build/host/arm-buildroot-linux-gnueabihf/sysroot:@STAGING_DIR@:g" \
		 \
		-e "s:\(['= ]\)/usr:\\1@STAGING_DIR@/usr:g" \
		-e "s:\(['= ]\)/lib:\\1@STAGING_DIR@/lib:g" \
		 \
		-e "s:@STAGING_DIR@:/workspace/build/host/arm-buildroot-linux-gnueabihf/sysroot:g" \
		-e "s:@BASE_DIR@:/workspace/build:g" \
		"${la}.fixed" && \
	if cmp -s "${la}" "${la}.fixed"; then \
		rm -f "${la}.fixed"; \
	else \
		mv "${la}.fixed" "${la}"; \
	fi || exit 1; \
done
