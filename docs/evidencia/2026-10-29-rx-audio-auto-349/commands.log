cd <WORKTREE>
RX349_SCRATCH=<SCRATCH> <SCRATCH>/../349-venv/bin/python -m pytest -q \
  docs/evidencia/2026-10-29-rx-audio-auto-349/scripts/test_benchmark.py
# 9 passed; exit=0
