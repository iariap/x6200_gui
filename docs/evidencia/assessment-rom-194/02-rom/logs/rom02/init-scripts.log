#!/bin/sh
#
# Anota el instante en que el kernel le pasa el control a los scripts, para poder medir el
# arranque completo. La GUI agrega su propia linea cuando ya esta dibujando (S20gui tambien).
# El resultado queda en /mnt/app_logs/boot.log
#

mkdir -p /mnt/app_logs
printf '%s  kernel listo: %s s de uptime\n' "$(date -u +%H:%M:%S)" "$(cut -d' ' -f1 /proc/uptime)" >> /mnt/app_logs/boot.log
exit 0
===== S01create_data =====
#!/bin/sh

start() {
    # Si ya existe una particion DATA (ext4 o vfat, segun la tarjeta), montarla con su
    # tipo real y salir. Evita que este script recree la tabla de particiones o formatee
    # una DATA existente: antes, al no encontrar "fat32", podia terminar en mkfs -t vfat.
    existingData=$(blkid -L DATA)
    if [ -n "$existingData" ]; then
        existingType=$(blkid -o value -s TYPE "$existingData" 2>/dev/null)
        [ -n "$existingType" ] || existingType=$(blkid "$existingData" | sed 's/.*TYPE="\([^"]*\)".*/\1/')
        echo "DATA ya existe ($existingData, $existingType): la monto y no toco la tabla"
        grep -q " /mnt " /proc/mounts || mount -t "$existingType" "$existingData" /mnt 2>/dev/null
        return
    fi
    # Check fat32 not exists
    parted -m -s /dev/mmcblk0 print | grep fat32
    retVal=$?
    if [ $retVal -eq 0 ]; then
        echo "Fat32 partition already exists"
        return
    fi
    # Get free space info
    FREE_INFO=$(parted -sm /dev/mmcblk0 print free | tail -n1 | grep free)
    retVal=$?
    if [ $retVal -ne 0 ]; then
        echo "No free space available"
        return
    fi
    FREE_ARR=(${FREE_INFO//:/ })
    # Create (or recreate) partition
    parted -m -s -a opt /dev/mmcblk0 mkpart primary fat32 ${FREE_ARR[1]} ${FREE_ARR[2]}
    partprobe /dev/mmcblk0
    # Check if we have a preexisting DATA partition
    dataPartition=$(blkid -L DATA)
    if [ -n "$dataPartition" ]; then
        echo "Mount existing data partition"
        # Mount partition
        mount $dataPartition
        return
    fi
    # Format partition
    mkfs -t vfat -n DATA /dev/mmcblk0p3
    # Mount partition
    mount /dev/mmcblk0p3
}


case "$1" in
    start)
        start;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start}"
    exit 1
esac
