--- módulos hidp/uhid
/home/pablo/desa/x6200/assessment-194/scratch-196/rootfs/tree/lib/modules/6.1.82/kernel/net/bluetooth/hidp/hidp.ko 26156
--- config kernel
CONFIG_BT_HIDP=m
# CONFIG_UHID is not set
--- builtin
--- S39btpairings
    [ -f /mnt/backups/bluetooth.tgz ] && tar xzf /mnt/backups/bluetooth.tgz -C /
    # Bluetooth keyboards: classic ones go through hidp, Low Energy ones (HOGP) through uhid
    modprobe hidp 2>/dev/null
    modprobe uhid 2>/dev/null
    ;;
esac

exit 0
