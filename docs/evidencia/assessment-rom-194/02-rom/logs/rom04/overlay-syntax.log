diff_rc=1
--- wrapper loop
     1	#!/bin/sh
     2	mkdir -p /mnt/app_logs/
     3	# Los assets (4,4 MB) los lee la GUI de /dev/shm/images. Antes se copiaban ahi en cada
     4	# arranque: esa copia cuesta ~0,24 s y 4,4 MB de RAM. Un bind mount es instantaneo, asi que
     5	# se engancha la carpeta de la raiz; si el bind falla (kernel sin soporte) se copia como
     6	# antes, que es lo que se hacia.
     7	mkdir -p /dev/shm/images
     8	if ! mountpoint -q /dev/shm/images; then
     9	    mount --bind /usr/share/x6200/images /dev/shm/images 2>/dev/null || {
    10	        rm -rf /dev/shm/images
    11	        cp -R /usr/share/x6200/images /dev/shm/
    12	    }
    13	fi
    14	while true; do
    15	    /usr/sbin/x6200_gui > /tmp/x6200_log.txt 2>&1 || sync; mv /tmp/x6200_log.txt /mnt/app_logs/x6200_log_$(date +%Y-%m-%d_%H-%M-%S).txt
    16	done
--- S20gui seed
    20		mountpoint -q /dev/shm || mount -t tmpfs -o mode=1777 tmpfs /dev/shm 2>/dev/null || true
    21		mkdir -p /mnt/app_logs
    22		printf '%s  GUI arrancando: %s s de uptime\n' "$(date -u +%H:%M:%S)" "$(cut -d" " -f1 /proc/uptime)" >> /mnt/app_logs/boot.log
    23		[ ! -f /mnt/params.db ] && cp /usr/share/x6200/params.default.db /mnt/params.db
    24		# shellcheck disable=SC2086 # we need the word splitting
    25		start-stop-daemon -S -b -q -m -p "$PIDFILE" -x "/usr/sbin/$DAEMON"
    26		status=$?
    27		if [ "$status" -eq 0 ]; then
    28			echo "OK"
    29		else
    30			echo "FAIL"
    31		fi
    32		return "$status"
