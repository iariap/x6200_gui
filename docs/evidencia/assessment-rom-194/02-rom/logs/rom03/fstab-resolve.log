--- guard grep fat32 sobre la imagen real
grep_fat32_rc=1 (1 = no matchea, el script sigue)
--- fstab p3
SOURCE         TARGET   FSTYPE OPTIONS
/dev/root      /        ext2   rw,noauto
proc           /proc    proc   defaults
devpts         /dev/pts devpts defaults,gid=5,mode=620,ptmxmode=0666
tmpfs          /dev/shm tmpfs  mode=0777
tmpfs          /tmp     tmpfs  mode=1777
tmpfs          /run     tmpfs  mode=0755,nosuid,nodev
sysfs          /sys     sysfs  defaults
/dev/mmcblk0p3 /mnt     ext4   rw
--- mount -f (sin syscall) resuelve p3
mount: /dev/mmcblk0p3 mounted on /mnt.
mount_fake_rc=0
--- copia privada agrandada a 2 GiB para ver espacio libre
