--- a/br2_external/board/X6200/linux/rootfs-overlay/etc/init.d/S01create_data
+++ b/br2_external/board/X6200/linux/rootfs-overlay/etc/init.d/S01create_data
@@
-    # Only a partition with no signature at all is formatted: if something older
-    # shows up here, it is not ours and it stays untouched.
-    old_sig=""
-    rc=0
-    old_sig=$(blkid "$DATA" 2>/dev/null) || rc=$?
-    case $rc in
-        2) ;;
-        0) fail "$DATA already carries a filesystem (${old_sig}): refusing to format it" ;;
-        *) fail "cannot read $DATA (blkid exited $rc)" ;;
-    esac
+    # Only a partition with no FILESYSTEM is formatted. blkid on a bare
+    # partition can succeed with only PARTUUID=... and no TYPE; that is not a
+    # filesystem and must not stop the mkfs.
+    old_type=""
+    rc=0
+    old_type=$(blkid -o value -s TYPE "$DATA" 2>/dev/null) || rc=$?
+    case $rc in
+        0 | 2) ;;
+        *) fail "cannot read $DATA (blkid exited $rc)" ;;
+    esac
+    [ -z "$old_type" ] ||
+        fail "$DATA already carries a filesystem (${old_type}): refusing to format it"
