        14
        15  # No HFP/HSP at all: on this radio family SCO gives no audio and drops the
        16  # WiFi, so PulseAudio has no headset backend. headset=ofono without oFono = no headset backend.
        17  unload-module module-bluetooth-discover
        18  load-module module-bluetooth-discover headset=ofono
