         1  # Bluetooth audio: A2DP headphones only, no automatic routing.
         2  # The RX audio goes to the headphones through a loopback that
         3  # /usr/sbin/btaudio-ctl loads when asked to (Settings -> Wireless).
         4  .nofail
         5
         6  # A phone/tablet that connects for CAT also connects as an A2DP source, and
         7  # the default policy loops it into alsa_output (the radio TX audio):
         8  # a2dp_source=false. auto_switch=0: never switch a card to HFP/HSP.
         9  unload-module module-bluetooth-policy
        10  load-module module-bluetooth-policy auto_switch=0 a2dp_source=false ag=false
