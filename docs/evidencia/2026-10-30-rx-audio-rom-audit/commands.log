### 3.5 rootfs: S11radio_daemon (serial BASE: 's' al stop)
$ cat -n /home/pablo/desa/x6200/rom-build/clone-buildroot/br2_external/board/X6200/linux/rootfs-overlay/etc/init.d/S11radio_daemon
         1  #!/bin/sh
         2
         3  case "$1" in
         4      start)
         5          # create DNS soft link
         6          ln -sf /run/NetworkManager/resolv.conf /etc/resolv.conf
         7          # show power on wellcome screen
         8          ;;
         9      stop)
        10          # Turn off BASE board
        11          stty -F /dev/ttyS1 1152000
        12          echo s > /dev/ttyS1
        13          ;;
        14      *)
        15          echo "Usage: $0 {start|stop}"
        16          exit 1
        17          ;;
        18  esac
        19
        20  exit 0
