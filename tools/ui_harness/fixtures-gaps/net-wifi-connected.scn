# net-wifi-connected: pantalla principal con el estado de Bluetooth/WiFi INYECTADO (UI AUDIT
# gaps). El arnes no compila src/bt_state.c (lee los archivos de btcat-ctl) ni
# src/wifi.cpp (habla con NetworkManager), asi que el doble (mocks/mock_ui_deps.c)
# fija a mano uno de los tres estados VISIBLES del icono de la barra (src/info.c):
# apagado = icon_off, prendido = text_dim, conectado = text.
#
# WiFi conectado (text); Bluetooth apagado.
#
# COBERTURA SYNTHETIC: mide layout y contraste de esos estados con el doble; NO
# prueba la funcion real de BT/WiFi (sin radio, sin adaptador). Deterministico.
# scenario_settle comprueba sobre el arbol vivo que el color dibujado es el que
# la regla de src/info.c pide para el estado inyectado (si no, corta).

name net-wifi-connected
screen main

seed 20
bt_state off
wifi_status connected

frequency_hz 14074000
tx_frequency_hz 14074000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
