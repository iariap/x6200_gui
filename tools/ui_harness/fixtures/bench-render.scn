# bench-render: the benchmark fixture. It renders the main screen with the
# waterfall peaks on (the heaviest real draw work in the suite) and declares the
# benchmark knobs explicitly so a candidate revision can force extra redraw work
# per frame and the benchmark has to detect the cost regression.
#
# `bench_redraw_passes` is honoured only with `--bench`; it never changes the
# rendered PNG (the screen is repainted, not modified). See tools/ui_harness/README.md.

name bench-render
screen main

seed 11
theme Legacy
spectrum_peak true
waterfall_center_line true
spectrum_filled true

frequency_hz 14074000
tx_frequency_hz 14074000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -90

battery_v 12.3
external_v 13.8
battery_cap 84
charging false

rxtx rx

bench_warmup 3
bench_repeats 5
bench_redraw_passes 1
