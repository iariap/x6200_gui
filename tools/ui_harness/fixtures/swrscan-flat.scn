# swrscan-flat: 3 pasadas sobre `flat_3pass`: todas las medianas son
# iguales, o sea que no hay un minimo creible. El readout reporta el primero de los
# indices con el valor minimo (empate) con MAD 0.0: la captura tiene que mostrar que
# el banco NO afirma una resonancia unica. requires-radio.

name swrscan-flat
screen swrscan

seed 20

swr_dataset flat_3pass
swr_passes 3

frequency_hz 7100000
tx_frequency_hz 7100000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
