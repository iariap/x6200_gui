# main-tema-rs: the real main screen under the "RS" theme the ROM ships as a
# JSON file with its own images (rootfs/usr/share/x6200/themes/RS/theme.json,
# base Classic + arial). It is the theme fixture UI-007 needs. Same radio state
# as home-usb-20m, so the only variable is the theme.

name main-tema-rs
screen main

theme RS
seed 20

frequency_hz 14074000
tx_frequency_hz 14074000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
