# dfl-lsb-d: banda pasante RX a escala (issue #173, PR 1).
#
# Espejo del golden: LSB-D, 14.200.000 Hz, span 48 kHz, filtro real -3525..-225
# (low 225 / high 3525). La banda se dibuja a la IZQUIERDA del VFO (x341..396).

name dfl-lsb-d
screen main

seed 173
theme Aurora
spectrum_filled true
spectrum_peak true
waterfall_center_line true

frequency_hz 14200000
tx_frequency_hz 14200000
fft_width_hz 48000

mode LSB-D
filter_low 225
filter_high 3525
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
