# dfl-presets-apply: un toque en el favorito 1 aplica el preset sin mover el VFO (issue #183)
#
# Abre el DFL con la tecla CORTA DFL del firmware y maneja las paginas con las
# cinco teclas fisicas (o el toque REAL de las celdas, en los fixtures touch*).
# Las interacciones y sus aserciones corren en scenario_settle (screens.c).

name dfl-presets-apply
screen dfl-presets-apply

seed 183
theme Aurora
spectrum_filled true
spectrum_peak true
waterfall_center_line true

frequency_hz 14200000
tx_frequency_hz 14200000
fft_width_hz 48000

mode USB
filter_low 225
filter_high 3525
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
