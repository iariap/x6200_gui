# swrscan-5pass-moving: 5 pasadas (Fine) sobre `moving_5pass`: la resonancia
# se mueve entre pasadas (7.092 -> 7.108 MHz). El readout tiene que reportar la
# inestabilidad (MAD grande) y NO un unico minimo creible; no se puede afirmar una
# resonancia unica con datos que se mueven. 5 pasadas son TX multipasada:
# requires-radio.

name swrscan-5pass-moving
screen swrscan

seed 20

swr_dataset moving_5pass
swr_passes 5

frequency_hz 7100000
tx_frequency_hz 7100000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
