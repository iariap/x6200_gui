# main-tema-outdoor-negative: the real main screen under the builtin
# "Outdoor-Negative" theme (Outdoor with every colour and the waterfall through
# negative(), src/theme.c). It is the dark pair of main-otro-tema, for the
# contrast audit. Same radio state as home-usb-20m.

name main-tema-outdoor-negative
screen main

theme Outdoor-Negative
seed 20

frequency_hz 14074000
tx_frequency_hz 14074000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
