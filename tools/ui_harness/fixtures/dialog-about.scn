# dialog-about: the real main screen with the firmware's real About window open
# over it. The path is the firmware's own: main_screen_action(ACTION_APP_ABOUT)
# -> src/main_screen.c -> src/dialog.c (dialog_construct/dialog_init) ->
# src/dialog_about.c (the title/version/callsign/author labels). See
# tools/ui_harness/README.md; the JSON reports which dialog components are real.
#
# The radio state matches home-usb-20m so the only difference is the window.

name dialog-about
screen dialog-about

seed 20

frequency_hz 14074000
tx_frequency_hz 14074000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
