# swrscan-double-valley: 3 pasadas sobre `double_valley_3pass`: hay dos
# valles reales y el minimo medido es el mas bajo de los dos (7.080.000 Hz); no se
# fuerza una parabola unica. La curva dibujada es decorativa y se corta en los
# huecos, pero el minimo y el readout salen del dato medido. requires-radio.

name swrscan-double-valley
screen swrscan

seed 20

swr_dataset double_valley_3pass
swr_passes 3

frequency_hz 7100000
tx_frequency_hz 7100000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
