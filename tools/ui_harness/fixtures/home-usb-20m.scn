# # home-usb-20m: the top bar of the main screen, 20 m USB, S9 signal, on battery.
# Milestone 1 renders the components that compile without the DSP/hardware path
# (clock, info, meter). See tools/ui_harness/README.md for the coverage table.

name home-usb-20m
screen home-usb-20m

frequency_hz 14074000
tx_frequency_hz 14074000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
