# dfl-presets-mode-change: cambiar de FAMILIA en plena Asignar/Confirmar cancela
# la operacion sin persistir ni aplicar (issue #183, seccion 5.6).
#
# Arranca en USB (SSB), hace hold sobre el favorito 1 para entrar a Elegir origen
# y despues cambia el modo a USB-D (otra familia): la pagina vuelve a A, no se
# escribe ningun enlace. Repite con Confirmar y termina en NFM (sin catalogo),
# donde el DFL queda en Ajustar.

name dfl-presets-mode-change
screen dfl-presets-mode-change

seed 183
theme Aurora
spectrum_filled true
spectrum_peak true
waterfall_center_line true

frequency_hz 14200000
tx_frequency_hz 14200000
fft_width_hz 48000

mode USB
filter_low 225
filter_high 3525
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
