# settings-rs-theme: the real Ajustes window under the "RS" shipped theme
# (rootfs/usr/share/x6200/themes/RS/theme.json, base Classic + arial), scrolled to
# the Spectrum/waterfall group so the switch rail (styles.c styles_switch_init,
# TC(control_border)) is drawn on screen. UI-007: the historical finding was RS
# inheriting a control_border below 2.58:1; the key now exists in its JSON and the
# static check `x6200-ab themes` measures the pair, but no fixture rendered it. This
# is the same real path as settings-wfbat (main_screen_action(ACTION_APP_SETTINGS)
# -> dialog_construct -> src/dialog_settings.c, then "Mas >" + "Espectro") with the
# theme as the only variable, so the switch rail renders with RS's control_border.
#
# Deterministic: the date/time fields read the harness' fixed clock, not the host's
# (tools/ui_harness/CMakeLists.txt links with `--wrap=time`).

name settings-rs-theme
screen settings-wfbat
theme RS

seed 20

frequency_hz 14074000
tx_frequency_hz 14074000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
