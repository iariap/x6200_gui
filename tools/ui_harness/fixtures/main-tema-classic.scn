# main-tema-classic: the real main screen under the builtin "Classic" theme
# (black and grey, IC-7300 style; its shape names the Arial family, which the
# harness now applies the way the firmware's main() does). Same radio state as
# home-usb-20m.

name main-tema-classic
screen main

theme Classic
seed 20

frequency_hz 14074000
tx_frequency_hz 14074000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
