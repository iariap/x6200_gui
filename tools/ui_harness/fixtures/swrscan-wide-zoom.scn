# swrscan-wide-zoom: 3 pasadas sobre `wide_zoom_3pass`: span de 500 kHz
# (paso de 10 kHz). El valle agudo queda entre puntos y NO se resuelve: el readout
# reporta el minimo que si se midio, que no es la resonancia real. La ventana de
# 500 kHz centrada en 7.100.000 Hz se sale de la asignacion de 40 m: es un
# dataset SOLO de mock (tests/fixtures/swrscan/README.md) y la ROM tiene que
# bloquear su transmision real. requires-radio.

name swrscan-wide-zoom
screen swrscan

seed 20

swr_dataset wide_zoom_3pass
swr_passes 3

frequency_hz 7100000
tx_frequency_hz 7100000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
