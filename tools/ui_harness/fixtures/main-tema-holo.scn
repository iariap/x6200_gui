# main-tema-holo: the real main screen under the "Holo" theme the ROM ships as a
# JSON file (rootfs/usr/share/x6200/themes/Holo.json, base IU1WXY, radius 0). It
# exercises the JSON loader on a flat theme with no images. Same radio state as
# home-usb-20m.

name main-tema-holo
screen main

theme Holo
seed 20

frequency_hz 14074000
tx_frequency_hz 14074000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
