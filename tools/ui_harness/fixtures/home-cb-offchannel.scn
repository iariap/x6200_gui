# home-cb-offchannel: la misma pantalla CB que `home-cb`, pero en 27,000 MHz,
# que cae entre el canal 3 (26.985) y el 4 (27.005): no es un canal del plan.
# La celda VFO muestra "CH --" (issue #146, seccion 6.2) y el primer giro del
# dial engancha el canal siguiente en la direccion del giro.
#
# See tools/ui_harness/README.md for the coverage table.

name home-cb-offchannel
screen main

seed 147

frequency_hz 27000000
tx_frequency_hz 27000000
fft_width_hz 100000

mode am
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
