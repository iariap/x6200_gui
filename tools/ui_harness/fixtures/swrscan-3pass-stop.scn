# swrscan-3pass-stop: la misma sesion de 3 pasadas, cancelada por el
# operador con el boton (que ya dice "Stop") despues de 70 puntos.
#
# Lo que la captura tiene que mostrar: estado "Stopped (parcial)", la grafica con
# lo medido hasta el corte (congelada) y el readout del minimo medido, marcado
# como parcial. La sesion NO puede seguir midiendo ni transmitir despues del Stop
# (el backend prueba que no hay mas comandos de VFO ni otra sesion).

name swrscan-3pass-stop
screen swrscan

seed 20

swr_dataset single_valley_3pass
swr_passes 3
swr_feed 70
swr_stop true

frequency_hz 7100000
tx_frequency_hz 7100000
fft_width_hz 384000

mode usb
vfo A
agc auto

split false
att false
pre false
atu false
ant 1

smeter_db -73

battery_v 12.1
external_v 13.8
battery_cap 76
charging false

rxtx rx
