# main-bateria-baja: main screen on a nearly flat battery with no external
# supply. Since issue #250 the clock is permanent (the time is always there) and
# the 7% cap of this fixture is the low state of the status band (`7%` next to
# the empty-cell icon); the `external_v 0.0` of the pack keeps the supply label
# off the panel.

name main-bateria-baja
screen main

seed 44

frequency_hz 7100000
tx_frequency_hz 7100000
fft_width_hz 384000

mode lsb
vfo A
agc slow

split false
att false
pre false
atu false
ant 1

smeter_db -95

battery_v 10.6
external_v 0.0
battery_cap 7
charging false

rxtx rx
