# main-bateria-baja: main screen on a nearly flat battery (the clock drops to
# the battery-percentage view because the external supply is below 3 V).

name main-bateria-baja
screen main

seed 44

frequency_hz 7100000
tx_frequency_hz 7100000
fft_width_hz 384000

mode lsb
vfo A
agc slow

split false
att false
pre false
atu false
ant 1

smeter_db -95

battery_v 10.6
external_v 0.0
battery_cap 7
charging false

rxtx rx
