# main-otro-tema: the same main screen under the builtin "Outdoor" theme
# (light, high contrast, its own waterfall palette), a different seed.

name main-otro-tema
screen main

seed 66
theme Outdoor

frequency_hz 10125000
tx_frequency_hz 10125000
fft_width_hz 384000

mode cw
vfo B
agc fast

split false
att false
pre false
atu false
ant 1

smeter_db -79

battery_v 12.2
external_v 13.8
battery_cap 80
charging false

rxtx rx
